# ============================================================
# ROLEX AI v2.2.0 — environment configuration (copy to .env)
# ============================================================

# --- General -------------------------------------------------
ROLEX_LOG_LEVEL=INFO
ROLEX_LANG=auto            # auto | ta | en | tanglish
ROLEX_CONFIDENCE=0.65

# --- AI Providers (optional — Rolex works fully without these)
# AI providers are INTELLIGENCE SOURCES only. Final answer is Rolex's.
# TIP: HUD → Settings → paste key → SAVE works too (encrypted store,
#      picked up live without restart!)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
