# ============================================================
# ROLEX AI v2.2.0 — environment configuration (copy to .env)
# ============================================================

# --- General -------------------------------------------------
ROLEX_LOG_LEVEL=INFO
ROLEX_LANG=auto            # auto | ta | en | tanglish
ROLEX_CONFIDENCE=0.65

# --- AI Providers (optional — Rolex works fully without these)
# AI providers are INTELLIGENCE SOURCES only. Final answer is Rolex's.
# TIP: HUD → Settings → paste key → SAVE works too (encrypted store,
#      picked up live without restart!)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Voice / Weather / Search keys (all optional) --------------
# ELEVENLABS_API_KEY  → premium voice TTS (falls back to pyttsx3 local)
# OPENWEATHER_API_KEY → api.openweathermap.org (falls back to Open-Meteo keyless)
# SERPER_API_KEY      → google.serper.dev web search
# TAVILY_API_KEY      → api.tavily.com web search (serper missing → tavily)
ELEVENLABS_API_KEY=
OPENWEATHER_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# --- Networking ----------------------------------------------
ROLEX_AI_TIMEOUT=20
ROLEX_AI_RETRIES=2
ROLEX_AI_PARALLEL=1

# --- v2 Sync / Backup (§20) ------------------------------------
ROLEX_SYNC_VPS=            # user@host for rsync push (empty = local-only)
ROLEX_DRIVE_REMOTE=gdrive  # rclone remote name for Google Drive

# --- v2 Remote Lab (§21) ---------------------------------------
ROLEX_LAB_PORT=8765        # TCP/JSON remote control port
ROLEX_LAB_TOKEN=           # pairing secret — REQUIRED to enable remote lab

# --- v2 HUD (web UI bridge) ------------------------------------
ROLEX_HUD_PORT=8777        # python -m rolex.ui.bridge  → http://127.0.0.1:8777
